{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "编译 C 文件",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/C",
                "chcp 65001 > nul && \"C:\\mingw64\\x86_64-16.2.0-release-mcf-seh-ucrt-rt_v14-rev1\\mingw64\\bin\\gcc.exe\" -g -Wall -std=c11 \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && echo [编译成功] ${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false
            }
        },
        {
            "label": "编译并运行",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/C",
                "chcp 65001 > nul && \"C:\\mingw64\\x86_64-16.2.0-release-mcf-seh-ucrt-rt_v14-rev1\\mingw64\\bin\\gcc.exe\" -g -Wall -std=c11 \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\" && echo ------ 运行结果 ------ && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""
            ],
            "group": "test",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true,
                "echo": false
            }
        }
    ]
}
